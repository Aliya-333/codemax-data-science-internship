     "text": [
      "Choose an option:  2\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Difference: 1\n",
      "\n",
      "1. SUM | 2. DIFFERENCE | 3. MULTIPLICATION | 4. DIVISION\n"
     ]
    },
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Choose an option:  3\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Product: 12\n",
      "\n",
      "1. SUM | 2. DIFFERENCE | 3. MULTIPLICATION | 4. DIVISION\n"
     ]
    },
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Choose an option:  4\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Remainder: 1.3333333333333333\n"
     ]
    }
   ],
   "source": [
    "a=int(input(\"First no:\"))\n",
    "b=int(input(\"Second no:\"))\n",
    "while True:\n",
    "    print(\"\\n1. SUM | 2. DIFFERENCE | 3. MULTIPLICATION | 4. DIVISION\")\n",
    "    c = input(\"Choose an option: \")\n",
    "    if c==\"1\":\n",
    "        S=a+b;\n",
    "        print(\"Sum:\",S)\n",
    "    elif c==\"2\":\n",
    "        d=a-b;\n",
    "        print(\"Difference:\",d)\n",
    "    elif c==\"3\":\n",
    "        p=a*b;\n",
    "        print(\"Product:\",p)\n",
    "    elif c==\"4\":\n",
    "        r=a/b;\n",
    "        print(\"Remainder:\",r)\n",
    "        break\n",
    "    else:\n",
    "        print(\"incorrect answer\")\n",
    "    "
   ]
  },
