   "source": [
    "# Student details\n",
    "name = \"Aliya S\"\n",
    "age = 20\n",
    "course = \"BCA\"\n",
    "percentage = 84.5\n",
    "is_student = True\n",
    "\n",
    "# Additional information\n",
    "total_marks = 422\n",
    "subjects = 5\n",
    "average = total_marks / subjects\n",
    "passed = percentage >= 40\n",
    "\n",
    "# Display profile\n",
    "print(\"----- Student Profile -----\")\n",
    "print()\n",
    "print(\"Name:\", name)\n",
    "print(\"Age:\", age)\n",
    "print(\"Course:\", course)\n",
    "print(\"Percentage:\", percentage)\n",
    "print(\"Total Marks:\", total_marks)\n",
    "print(\"Average Marks:\", average)\n",
    "print(\"Student:\", is_student)\n",
    "print(\"Passed:\", passed)"
   ]
  },
