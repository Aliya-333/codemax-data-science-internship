   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter Maths marks:  100\n",
      "Enter Python marks:  99\n",
      "Enter Data Science marks:  98\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Total Marks: 297\n",
      "Average Marks: 99.0\n",
      "Percentage: 99.0 %\n"
     ]
    }
   ],
   "source": [
    "maths = int(input(\"Enter Maths marks: \"))\n",
    "python = int(input(\"Enter Python marks: \"))\n",
    "data_science = int(input(\"Enter Data Science marks: \"))\n",
    "\n",
    "total = maths + python + data_science\n",
    "average = total / 3\n",
    "percentage = (total / 300) * 100\n",
    "\n",
    "print(\"Total Marks:\", total)\n",
    "print(\"Average Marks:\", average)\n",
    "print(\"Percentage:\", percentage, \"%\")"
   ]
  },
