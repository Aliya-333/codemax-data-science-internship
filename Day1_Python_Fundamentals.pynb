   "id": "8e39b69d-fcd0-454b-8909-d126e2d87750",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Notebook Total: ₹ 150\n",
      "Pen Total: ₹ 50\n",
      "Bag Total: ₹ 500\n",
      "Grand Total: ₹ 700\n"
     ]
    }
   ],
   "source": [
    "# Product details\n",
    "notebook_price = 50\n",
    "notebook_quantity = 3\n",
    "\n",
    "pen_price = 10\n",
    "pen_quantity = 5\n",
    "\n",
    "bag_price = 500\n",
    "bag_quantity = 1\n",
    "\n",
    "# Calculate individual totals\n",
    "notebook_total = notebook_price * notebook_quantity\n",
    "pen_total = pen_price * pen_quantity\n",
    "bag_total = bag_price * bag_quantity\n",
    "\n",
    "# Calculate grand total\n",
    "grand_total = notebook_total + pen_total + bag_total\n",
    "\n",
    "# Display the bill\n",
    "print(\"Notebook Total: ₹\", notebook_total)\n",
    "print(\"Pen Total: ₹\", pen_total)\n",
    "print(\"Bag Total: ₹\", bag_total)\n",
    "print(\"Grand Total: ₹\", grand_total)"
   ]
  },
