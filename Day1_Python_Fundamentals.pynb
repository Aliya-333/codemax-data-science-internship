    "course = input(\"Enter your course: \")\n",
    "percentage = float(input(\"Enter your percentage: \"))\n",
    "is_student = input(\"Are you a student? (True/False): \")\n",
    "\n",
    "passed = percentage >= 40\n",
    "\n",
    "print(\"\\n----- Profile -----\")\n",
    "print(\"Name:\", name)\n",
    "print(\"Age:\", age)\n",
    "print(\"Course:\", course)\n",
    "print(\"Percentage:\", percentage)\n",
    "print(\"Student:\", is_student)\n",
    "print(\"Passed:\", passed)"
   ]
