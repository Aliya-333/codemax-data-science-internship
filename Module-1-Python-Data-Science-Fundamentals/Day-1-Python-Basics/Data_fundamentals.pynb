   "source": [
    "Day 5 Mini Project: Student Performance Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "b3ba1ad5-bae2-4af5-aef1-54921e468c83",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "     Name  Python  Statistics  SQL\n",
      "0    Arun      85          80   90\n",
      "1     Anu      92          89   94\n",
      "2   Rahul      70          75   68\n",
      "3   Meera      88          91   85\n",
      "4   Akhil      95          90   92\n",
      "5    Neha      65          72   70\n",
      "6  Vishnu      78          82   80\n"
     ]
    }
   ],
   "source": [
    "import pandas as pd\n",
    "\n",
    "data = {\n",
    "    \"Name\": [\n",
    "        \"Arun\",\n",
    "        \"Anu\",\n",
    "        \"Rahul\",\n",
    "        \"Meera\",\n",
    "        \"Akhil\",\n",
    "        \"Neha\",\n",
    "        \"Vishnu\"\n",
    "    ],\n",
    "\n",
    "    \"Python\": [85, 92, 70, 88, 95, 65, 78],\n",
    "\n",
    "    \"Statistics\": [80, 89, 75, 91, 90, 72, 82],\n",
    "\n",
    "    \"SQL\": [90, 94, 68, 85, 92, 70, 80]\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "print(df)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "4f1b5fae-0068-4c94-a41d-a35c1a270b87",
   "metadata": {},
   "outputs": [],
   "source": [
    "df[\"Total\"] = df[\"Python\"] + df[\"Statistics\"] + df[\"SQL\"]"
   ]
  },
