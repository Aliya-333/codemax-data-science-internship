   "cell_type": "code",
   "execution_count": 25,
   "id": "a204b4ef-1348-445c-96d0-9ba07f490d59",
   "metadata": {},
   "outputs": [],
   "source": [
    "df[\"Average\"] = df[\"Total\"] / 3"
   ]
  },
