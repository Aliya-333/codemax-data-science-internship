    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "data = {\n",
    "    \"Name\": [\"Arun\", \"Anu\", \"Rahul\", \"Meera\"],\n",
    "    \"Marks\": [85, np.nan, 76, 90],\n",
    "    \"Course\": [\"BCA\", \"BCA\", \"BCom\", \"BCA\"]\n",
    "}\n",
    "\n",
    "df_missing = pd.DataFrame(data)\n",
    "\n",
    "print(df_missing)"
   ]
  },
