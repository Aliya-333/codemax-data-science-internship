{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "ce8cb138-d326-4370-899f-c8113e4390bc",
   "metadata": {},
   "source": [
    "CHECK POSITIVE ,NEGATIVE OR ZERO\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "a32d5562-96aa-4c6f-9197-818fd4b231b5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a number:  -9\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Negative\n"
     ]
    }
   ],
   "source": [
    "number = int(input(\"Enter a number: \"))\n",
    "\n",
    "if number > 0:\n",
    "    print(\"Positive\")\n",
    "elif number < 0:\n",
    "    print(\"Negative\")\n",
    "else:\n",
    "    print(\"Zero\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "659af318-5c2d-4c0a-8d8b-16820104fc52",
   "metadata": {},
   "source": [
    "CHECK EVEN OR ODD"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "8941a39b-83f2-430b-84b5-9f189b2bea7a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a number:  3\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Odd\n"
     ]
    }
   ],
   "source": [
    "\n",
    "number = int(input(\"Enter a number: \"))\n",
    "\n",
    "if number % 2 == 0:\n",
    "    print(\"Even\")\n",
    "else:\n",
    "    print(\"Odd\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8996db2e-484a-49e9-abb2-c92dda0c2bea",
   "metadata": {},
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "markdown",
   "id": "0c50f26d-a417-41b0-a0f0-01a7d4503fe0",
   "metadata": {},
   "source": [
    "LARGEST OF TWO NUMBERS"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "391f94de-ee25-4d1b-b082-8a92075a75a6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter first number:  3\n",
      "Enter second number:  6\n",
      "Enter third number:  5\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Largest number: 6\n"
     ]
    }
   ],
   "source": [
    "a = int(input(\"Enter first number: \"))\n",
    "b = int(input(\"Enter second number: \"))\n",
    "c = int(input(\"Enter third number: \"))\n",
    "\n",
    "if a >= b and a >= c:\n",
    "    largest = a\n",
    "elif b >= a and b >= c:\n",
    "    largest = b\n",
    "else:\n",
    "    largest = c\n",
    "\n",
    "print(\"Largest number:\", largest)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4a9161c0-3324-4df6-9acf-7f1e4d6d0b5d",
   "metadata": {},
   "source": [
    "PRINT NUMBERS USING FOR\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "30b0f5bb-80d8-47a3-92a3-412819bd46be",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a number:  4\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1\n",
      "2\n",
      "3\n",
      "4\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Enter a number: \"))\n",
    "\n",
    "for i in range(1, n + 1):\n",
    "    print(i)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2328a360-ab6c-4f47-9eb5-8b830ad857c4",
   "metadata": {},
   "source": [
    "SUM OF NUMBERS"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "2ed2e46d-eaed-40c9-91e8-ef5459536533",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a number:  4\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Sum: 10\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Enter a number: \"))\n",
    "\n",
    "total = 0\n",
    "\n",
    "for i in range(1, n + 1):\n",
    "    total = total + i\n",
    "\n",
    "print(\"Sum:\", total)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "828ed407-4197-4595-9ca9-95f48319183c",
   "metadata": {},
   "source": [
    "\n",
    "MULTIPLICATION TABLE"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "e0843ba4-70eb-47e3-835a-644d12e9e39c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a number:  4\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "4 x 1 = 4\n",
      "4 x 2 = 8\n",
      "4 x 3 = 12\n",
      "4 x 4 = 16\n",
      "4 x 5 = 20\n",
      "4 x 6 = 24\n",
      "4 x 7 = 28\n",
      "4 x 8 = 32\n",
      "4 x 9 = 36\n",
      "4 x 10 = 40\n"
     ]
    }
   ],
   "source": [
    "number = int(input(\"Enter a number: \"))\n",
    "\n",
    "for i in range(1, 11):\n",
    "    print(number, \"x\", i, \"=\", number * i)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bb16b6fa-0bc4-4ae7-9c32-7bcc29b139db",
   "metadata": {},
   "source": [
    "SIMPLE PASSWORD CHECKER"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "39393561-4979-4794-b51a-a4e3b011499c",
   "metadata": {},
   "outputs": [],
   "source": [
    "correct_password = \"python123\"\n",
    "\n",
    "while True:\n",
    "    password = input(\"Enter password: \")\n",
    "\n",
    "    if password == correct_password:\n",
    "        print(\"Login successful!\")\n",
    "        break\n",
    "    else:\n",
    "        print(\"Incorrect password. Try again.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f734bd57-06ba-41e6-92a0-2374087e7071",
   "metadata": {},
   "source": [
    "SHOPPING LIST"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "e84339b5-03f0-4e1c-b3e3-9c7e9df66100",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Laptop\n",
      "Mouse\n",
      "Keyboard\n",
      "Monitor\n",
      "Headphones\n"
     ]
    }
   ],
   "source": [
    "products = [\"Laptop\", \"Mouse\", \"Keyboard\", \"Monitor\", \"Headphones\"]\n",
    "\n",
    "for product in products:\n",
    "    print(product)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1d85d797-fd2f-42ca-ae5f-227c45945ce1",
   "metadata": {},
   "source": [
    "STUDENTS MARK LIST"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "5e1037ec-f7c9-4838-95fb-419d32564ee5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Marks: [80, 75, 90, 85, 70]\n",
      "Total: 400\n",
      "Average: 80.0\n"
     ]
    }
   ],
   "source": [
    "marks = [80, 75, 90, 85, 70]\n",
    "\n",
    "total = sum(marks)\n",
    "average = total / len(marks)\n",
    "\n",
    "print(\"Marks:\", marks)\n",
    "print(\"Total:\", total)\n",
    "print(\"Average:\", average)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ec3829b5-def2-4a22-98f5-961ce3438d6e",
   "metadata": {},
   "source": [
    "STUDENT INFORMATION DICTIONARY"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "6321d5f8-f360-4d4c-83a9-5f485b3f46ae",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Name: Your Name\n",
      "Age: 20\n",
      "Course: BCA\n",
      "Percentage: 84.5\n"
     ]
    }
   ],
   "source": [
    "student = {\n",
    "    \"name\": \"Your Name\",\n",
    "    \"age\": 20,\n",
    "    \"course\": \"BCA\",\n",
    "    \"percentage\": 84.5\n",
    "}\n",
    "\n",
    "print(\"Name:\", student[\"name\"])\n",
    "print(\"Age:\", student[\"age\"])\n",
    "print(\"Course:\", student[\"course\"])\n",
    "print(\"Percentage:\", student[\"percentage\"])"
   ]
  },
