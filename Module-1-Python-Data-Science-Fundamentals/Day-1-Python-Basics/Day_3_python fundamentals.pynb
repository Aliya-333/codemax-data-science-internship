  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "13f0f06b-0d35-4b7b-851f-0a8d41ffcbfc",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter your name:  Aliya\n",
      "Enter your course:  BCA\n",
      "Enter your percentage:  84\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Student profile saved successfully!\n"
     ]
    }
   ],
   "source": [
    "def save_student(name, course, percentage):\n",
    "\n",
    "    file = open(\"student_profile.txt\", \"w\")\n",
    "\n",
    "    file.write(\"----- Student Profile -----\\n\")\n",
    "    file.write(\"Name: \" + name + \"\\n\")\n",
    "    file.write(\"Course: \" + course + \"\\n\")\n",
    "    file.write(\"Percentage: \" + str(percentage) + \"%\")\n",
    "\n",
    "    file.close()\n",
    "\n",
    "\n",
    "name = input(\"Enter your name: \")\n",
    "course = input(\"Enter your course: \")\n",
    "percentage = float(input(\"Enter your percentage: \"))\n",
    "\n",
    "save_student(name, course, percentage)\n",
    "\n",
    "print(\"Student profile saved successfully!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8c022a23-9fa4-4675-bcc6-5778535de61f",
   "metadata": {},
   "source": [
    "STUDENT RECORD SYSTEM"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "70b5c9bd-6998-4429-a678-d86b389fb480",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter student name:  ALIYAS\n",
      "Enter course:  BCA\n",
      "Enter percentage:  84\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "----- RESULT -----\n",
      "Name: ALIYAS\n",
      "Course: BCA\n",
      "Percentage: 84.0 %\n",
      "Grade: B\n",
      "\n",
      "Student record saved successfully!\n"
     ]
    }
   ],
   "source": [
    "def find_grade(percentage):\n",
    "\n",
    "    if percentage >= 90:\n",
    "        return \"A\"\n",
    "    elif percentage >= 80:\n",
    "        return \"B\"\n",
    "    elif percentage >= 70:\n",
    "        return \"C\"\n",
    "    elif percentage >= 60:\n",
    "        return \"D\"\n",
    "    else:\n",
    "        return \"F\"\n",
    "\n",
    "\n",
    "def save_record(name, course, percentage, grade):\n",
    "\n",
    "    file = open(\"student_record.txt\", \"w\")\n",
    "\n",
    "    file.write(\"----- STUDENT RECORD -----\\n\")\n",
    "    file.write(\"Name: \" + name + \"\\n\")\n",
    "    file.write(\"Course: \" + course + \"\\n\")\n",
    "    file.write(\"Percentage: \" + str(percentage) + \"%\\n\")\n",
    "    file.write(\"Grade: \" + grade)\n",
    "\n",
    "    file.close()\n",
    "\n",
    "\n",
    "name = input(\"Enter student name: \")\n",
    "course = input(\"Enter course: \")\n",
    "percentage = float(input(\"Enter percentage: \"))\n",
    "\n",
    "grade = find_grade(percentage)\n",
    "\n",
    "save_record(name, course, percentage, grade)\n",
    "\n",
    "print(\"\\n----- RESULT -----\")\n",
    "print(\"Name:\", name)\n",
    "print(\"Course:\", course)\n",
    "print(\"Percentage:\", percentage, \"%\")\n",
    "print(\"Grade:\", grade)\n",
    "\n",
    "print(\"\\nStudent record saved successfully!\")"
   ]
  },
