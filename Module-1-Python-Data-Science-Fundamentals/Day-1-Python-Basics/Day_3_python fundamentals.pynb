   "source": [
    "Simple Greeting Function"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "92286dc3-a643-4f87-9d44-bbb822ac0f71",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Welcome to Python!\n"
     ]
    }
   ],
   "source": [
    "def greet():\n",
    "    print(\"Welcome to Python!\")\n",
    "\n",
    "greet()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "9854868c-d431-47af-a9bc-b60354f7c402",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter your name:  ALIYA\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Hello ALIYA\n",
      "Welcome to Data Science!\n"
     ]
    }
   ],
   "source": [
    "def greet(name):\n",
    "    print(\"Hello\", name)\n",
    "    print(\"Welcome to Data Science!\")\n",
    "\n",
    "name = input(\"Enter your name: \")\n",
    "\n",
    "greet(name)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "48827885-1bef-4087-953d-3c35fd2d8c4d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter first number:  23\n",
      "Enter second number:  67\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Sum: 90\n"
     ]
    }
   ],
   "source": [
    "def add_numbers(a, b):\n",
    "    result = a + b\n",
    "    return result\n",
    "\n",
    "num1 = int(input(\"Enter first number: \"))\n",
    "num2 = int(input(\"Enter second number: \"))\n",
    "\n",
    "answer = add_numbers(num1, num2)\n",
    "\n",
    "print(\"Sum:\", answer)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "e8aebad5-bd7f-4c60-9437-0c6c927b1357",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter first number:  45\n",
      "Enter second number:  45\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1. Addition\n",
      "2. Subtraction\n",
      "3. Multiplication\n",
      "4. Division\n"
     ]
    },
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter your choice:  1\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Result: 90.0\n"
     ]
    }
   ],
   "source": [
    "def add(a, b):\n",
    "    return a + b\n",
    "\n",
    "def subtract(a, b):\n",
    "    return a - b\n",
    "\n",
    "def multiply(a, b):\n",
    "    return a * b\n",
    "\n",
    "def divide(a, b):\n",
    "    return a / b\n",
    "\n",
    "\n",
    "num1 = float(input(\"Enter first number: \"))\n",
    "num2 = float(input(\"Enter second number: \"))\n",
    "\n",
    "print(\"1. Addition\")\n",
    "print(\"2. Subtraction\")\n",
    "print(\"3. Multiplication\")\n",
    "print(\"4. Division\")\n",
    "\n",
    "choice = input(\"Enter your choice: \")\n",
    "\n",
    "if choice == \"1\":\n",
    "    print(\"Result:\", add(num1, num2))\n",
    "\n",
    "elif choice == \"2\":\n",
    "    print(\"Result:\", subtract(num1, num2))\n",
    "\n",
    "elif choice == \"3\":\n",
    "    print(\"Result:\", multiply(num1, num2))\n",
    "\n",
    "elif choice == \"4\":\n",
    "    if num2 != 0:\n",
    "        print(\"Result:\", divide(num1, num2))\n",
    "    else:\n",
    "        print(\"Cannot divide by zero\")\n",
    "\n",
    "else:\n",
    "    print(\"Invalid choice\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "14e19f86-ec22-40bd-b6f9-68b4e55557a6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter mark 1:  100\n",
      "Enter mark 2:  99\n",
      "Enter mark 3:  98\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Total: 297\n",
      "Average: 99.0\n",
      "Percentage: 99.0 %\n"
     ]
    }
   ],
   "source": [
    "def calculate_result(mark1, mark2, mark3):\n",
    "\n",
    "    total = mark1 + mark2 + mark3\n",
    "    average = total / 3\n",
    "    percentage = (total / 300) * 100\n",
    "\n",
    "    return total, average, percentage\n",
    "\n",
    "\n",
    "mark1 = int(input(\"Enter mark 1: \"))\n",
    "mark2 = int(input(\"Enter mark 2: \"))\n",
    "mark3 = int(input(\"Enter mark 3: \"))\n",
    "\n",
    "total, average, percentage = calculate_result(mark1, mark2, mark3)\n",
    "\n",
    "print(\"Total:\", total)\n",
    "print(\"Average:\", average)\n",
    "print(\"Percentage:\", percentage, \"%\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "299b74b6-e6b1-4199-b7c5-349338538764",
